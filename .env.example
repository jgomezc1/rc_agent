# ============================================================================
# RC Agent — environment configuration
#
# Copy this file to `.env` and fill in real values.
# Do NOT commit `.env` to git (it is gitignored).
# ============================================================================

# --- Anthropic API ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Claude model (uncomment one)
CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- ProDet runtime ---------------------------------------------------------
# The web app runs on Windows using two plain Python venvs (no conda).
# Venvs are created OUTSIDE Dropbox to avoid sync conflicts during pip installs:
#   %LOCALAPPDATA%\rc_agent\venvs\prodet    (Python 3.9, ProDet's pinned deps)
#   %LOCALAPPDATA%\rc_agent\venvs\backend   (newer Python, rc_agent backend deps)
# First-time setup: run `setup.bat`. Daily use: double-click `start.bat`.

# Path to the ProDet source repo.
PRODET_ROOT=C:\Users\jgomez\Dropbox\ProDes-Core

# Optional override for project folders. Defaults to rc_agent/projects/.
# PRODET_PROJECTS=C:\Users\jgomez\Dropbox\prodet_locales

# Optional override for ProDet's venv python. Only set this if your venv
# lives somewhere non-standard. Default is auto-discovered:
#   1. %LOCALAPPDATA%\rc_agent\venvs\prodet\Scripts\python.exe  (preferred)
#   2. <PRODET_ROOT>\.venv\Scripts\python.exe  (legacy, only if not in Dropbox)
# PRODET_PYTHON=C:\Users\jgomez\AppData\Local\rc_agent\venvs\prodet\Scripts\python.exe
